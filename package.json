{
  "name": "musictrivia",
  "version": "1.0.0",
  "description": "Music trivia game with web frontend, Discord bot, and Billboard data pipelines",
  "private": true,
  "scripts": {
    "install:all": "npm install --workspace backend --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start": "npm start --workspace backend",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onewingmatt/Musictrivia.git"
  },
  "keywords": ["music", "trivia", "discord", "bot", "quiz"],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/onewingmatt/Musictrivia/issues"
  },
  "homepage": "https://github.com/onewingmatt/Musictrivia#readme",
  "workspaces": [
    "frontend",
    "backend"
  ]
}
