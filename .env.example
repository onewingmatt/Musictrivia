# JWT secret for auth tokens — change this in production
JWT_SECRET=change-me-to-a-random-secret

# Admin panel access secret
ADMIN_SECRET=change-me-to-an-admin-secret

# Discord bot token (from https://discord.com/developers/applications)
# Leave blank to skip Discord bot initialization
DISCORD_TOKEN=

# Guild ID for instant slash command registration
# Leave blank for global-only registration (1hr cache)
GUILD_ID=

# HTTP proxy for yt-dlp (optional, e.g. http://proxy:8080)
YT_PROXY=
